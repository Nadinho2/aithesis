# ═══════════════════════════════════════════════════════════
# BrainPadi / AI Thesis — Environment Variables Template
# Copy this file to .env.local and fill in your actual keys.
# ═══════════════════════════════════════════════════════════

# Bachs (Primary Payment Gateway) — https://app.bachs.io
# Sandbox: sk_sandbox_... | Live: sk_live_...
BACHS_SECRET_KEY="sk_sandbox_your_bachs_secret_key_here"

# Webhook Signing Secret from Bachs Developer Portal -> Webhooks
# Endpoint: https://mybrainpadi.com/api/bachs-webhook
BACHS_WEBHOOK_SECRET="whsec_your_bachs_webhook_secret_here"

# Base API URL (optional):
# Automatically defaults to https://sandbox-api.bachs.io for sk_sandbox_ keys
# and https://api.bachs.io for sk_live_ keys.
# BACHS_API_BASE_URL="https://sandbox-api.bachs.io"

# Clerk (Authentication) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"

# App URL — used for checkout redirects and webhooks
# Local: http://localhost:3000 | Production: https://mybrainpadi.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Database & Storage) — https://supabase.com/dashboard
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"

# ⚠️ Service Role Key from Supabase Dashboard -> Settings -> API -> service_role key
# REQUIRED for server-side operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# AI Models (DeepSeek API) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk_your_deepseek_api_key_here"
# Optional overrides for specific pipelines:
# DEEPSEEK_API_KEY_THESIS="sk_..."
# DEEPSEEK_API_KEY_PROPOSAL="sk_..."

# Email Service (Resend) — https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"

# Citation & Academic Search (SerpApi) — https://serpapi.com
SERPAPI_KEY="your_serpapi_key_here"

# Development Flags
DISABLE_AUTH=false
